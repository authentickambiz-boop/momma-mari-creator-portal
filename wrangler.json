{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momma-mari-portal",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal",
      "database_id": "0",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMMUNITY_PHOTOS",
      "bucket_name": "community-photos"
    }
  ]
}
