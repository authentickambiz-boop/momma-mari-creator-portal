# Copy to .env.local for `npm run dev`. Never commit the filled-in file.
# On Webflow Cloud, add these in the environment's Environment variables tab.
# Mark every secret as a Secret Variable. Do not put secrets in NEXT_PUBLIC_ variables.

# Public URL of this app, no trailing slash.
# Local: http://localhost:43123
# Production, mounted at /portal: https://mommamari.com/portal
# Also add the webflow.io preview origin if you test before publishing the custom domain.
APP_BASE_URL=http://localhost:43123

# Must match the Webflow Cloud mount path. Leave empty for local `next dev`.
# Next.js inlines this at build time, so set it in Webflow before the first deploy.
# Used for plain <a> tags and client fetch() calls. <Link> does not need it.
NEXT_PUBLIC_BASE_PATH=

# IANA timezone for "today" and the Monday payout label.
AGENCY_TIMEZONE=America/New_York

# Random string, at least 16 characters. Signs session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated Google accounts that sign in as the agency admin.
# Compared case-insensitively. Creators are NOT listed here; they live in the creators table.
ADMIN_EMAILS=Kamron@mommamari.com
ADMIN_DISPLAY_NAME=Kamron

# Local practice sign-in that skips Google. Must be the string "true" to enable.
# Leave unset (or anything other than true) on Webflow Cloud.
AUTH_DEV_LOGIN=true

# Master bearer token for the agency bot. If this is empty, every /api/bot route returns 503.
# Generate a long random string. Send it as: Authorization: Bearer <token>
# Existing /api/bot routes accept only this value. Tokens created on the Access page are
# stored as hashes and stay scoped to the capabilities you grant. They are not set here.
BOT_API_TOKEN=

# Google sign-in (creator and admin login). Not the same thing as Drive upload.
# Create an OAuth client of type Web application. Authorized redirect URI:
#   ${APP_BASE_URL}/api/auth/callback
# Example production URI: https://mommamari.com/portal/api/auth/callback
# "Connect your email" uses this SAME redirect URI. Do not add a second one.
# On the OAuth consent screen, add these Gmail scopes (restricted):
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.compose
# Enable the Gmail API. While the app is unverified, add creators as test users
# (Google allows up to 100). A full public launch needs Google's restricted-scope review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail push (read-only). See docs/live-sync-setup.md.
# Topic the Gmail API publishes to, for example projects/your-project/topics/gmail-push
GMAIL_WATCH_TOPIC=
# Exact push URL, no trailing slash. Example: https://mommamari.com/portal/api/gmail/push
GMAIL_PUSH_AUDIENCE=
# Service account email on the push subscription's OIDC token.
GMAIL_PUSH_SERVICE_ACCOUNT=
# Bearer secret for the daily watch renewal: POST /api/cron/gmail-watch
GMAIL_WATCH_CRON_SECRET=

# Encrypts each creator's Gmail refresh token before it is saved. 32 bytes as 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mark this as a Secret Variable on Webflow Cloud. If it is empty, Connect your email refuses to start.
TOKEN_ENCRYPTION_KEY=

# Drive uploads. Provide ONE of the two options below.
# Option A — OAuth refresh token for the Google account that owns the draft folders.
# Uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from above. The client needs the
# https://www.googleapis.com/auth/drive scope, and you complete the consent flow once
# to mint GOOGLE_DRIVE_REFRESH_TOKEN. See README.
GOOGLE_DRIVE_REFRESH_TOKEN=

# Option B — service account JSON, as a single line. Share each creator's Drive
# folder with the service account's client_email as Editor.
# MariClare's folder already exists: 1Gmcgw_vSgxR07PTdHF--SN2k-2ZodEfE
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Used only when a creator row has no drive_folder_id.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Largest video the portal will accept, in bytes. Default 8 GiB.
MAX_UPLOAD_BYTES=8589934592
# Chunk size forwarded to Drive. Must be a multiple of 256 KB and at most 32 MB.
# Default 8 MB. The browser sends this size; the portal does not store the bytes.
UPLOAD_CHUNK_BYTES=8388608

# Optional. Leave unset. Creators keep signing on this site, at no extra cost.
# Set both only if you want BoldSign instead. Turning it on uses BoldSign (about $30/month).
# Nothing is charged while these stay empty, and the portal does not call BoldSign.
BOLDSIGN_ENABLED=
BOLDSIGN_API_KEY=

# Optional. Leave unset. Media kit stats are typed in by hand.
# Set to true only when Zernio stats should be allowed later. Nothing is pulled while this is empty.
ZERNIO_STATS_ENABLED=
# Optional placeholder for a referral perk, in cents. Leave empty.
# The Referrals page can set this later. Nothing is paid while it is empty, and nothing is paid automatically.
REFERRAL_PERK_CENTS=
# Stripe stays off unless STRIPE_ENABLED is the string "true" AND STRIPE_SECRET_KEY is set.
# Leave both empty. Nothing is charged while they are empty. The portal does not call Stripe.
# Payment links, subscriptions (payment_behavior=default_incomplete), and draft invoices
# are the only calls, and only after you add live keys. Do not put a secret key in this file.
STRIPE_ENABLED=
STRIPE_SECRET_KEY=
# Price id for the hosted creator email payment link. Ignored while Stripe is off.
STRIPE_PRICE_HOSTED_EMAIL=

# Creator Checkout stays off unless PAYMENTS_ENABLED is the string "true".
# Leave it empty. Plan and kit buttons say Coming soon, and the portal does not call Stripe.
# Checkout reads STRIPE_SECRET_KEY above. Do not paste the key here.
# Set APP_BASE_URL to https://mommamari.com/portal so Stripe returns to /portal.
PAYMENTS_ENABLED=
# Signs Stripe webhooks. Leave empty until the endpoint is added. Unsigned events are rejected.
# Webhook URL: https://mommamari.com/portal/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted
# A paid one-time Checkout is queued for the bots only when PAYMENTS_ENABLED is already "true".
# Member discounts are per plan in src/lib/payments-config.ts (Plus 10, Pro 20, Business included).
# Business does not open Checkout. That request goes straight to the fulfillment queue.
STRIPE_WEBHOOK_SECRET=

# Web push stays off unless this is the string "true".
# Leave empty. Quiet hours are 9 PM to 8 AM Eastern either way, and nothing is sent to a push service from this app.
PUSH_ENABLED=

# Local SQLite file used by `next dev` and `npm test` does not read this for tests
# (tests use memory). Ignored on Webflow Cloud, which uses the D1 binding named DB.
PORTAL_SQLITE_PATH=data/portal.sqlite
